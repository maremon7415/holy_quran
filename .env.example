# Accounts & cloud sync are OPTIONAL. Leave everything unset and the app runs fully offline-first
# (data stays in the browser; the sign-in UI is hidden / shows "Accounts not enabled").

# MongoDB connection string (Atlas or self-hosted). Required for accounts.
MONGODB_URI=

# Secret used to sign session JWTs. Required for accounts. Generate with: npx auth secret   (or: openssl rand -base64 32)
# The legacy name NEXTAUTH_SECRET is also accepted.
AUTH_SECRET=

# Optional: enable "Continue with Google". Both must be set; the button is hidden otherwise.
# Redirect URI to register: <your-origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── SEO & AI visibility (all optional) ─────────────────────────────────────────
# Canonical production origin (used for canonical URLs, sitemaps, OG, llms.txt, API/MCP citation URLs)
NEXT_PUBLIC_SITE_URL=
# IndexNow key (8–128 chars of a-z A-Z 0-9 -). Served at /<key>.txt; `pnpm indexnow` submits every sitemap URL.
# Generate one with: openssl rand -hex 16
INDEXNOW_KEY=
# Used by `pnpm indexnow` / the IndexNow workflow (falls back to NEXT_PUBLIC_SITE_URL)
SITE_URL=
# Search-console ownership verification meta tags
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=
