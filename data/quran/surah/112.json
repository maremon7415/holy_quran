[{"n":1,"k":"112:1","ar":" قُلْ هُوَ ٱللَّهُ أَحَدٌ","sim":"قل هو الله احد","en":"Say, \"He is Allāh, [who is] One,","enH":"Say, ‘He is God the One,","bn":"বল, তিনি আল্লাহ, এক অদ্বিতীয়,","tl":"Qul huwa Allahu ahad","j":30,"p":604,"h":60,"r":556,"s":0},{"n":2,"k":"112:2","ar":"ٱللَّهُ ٱلصَّمَدُ","sim":"الله الصمد","en":"Allāh, the Eternal Refuge.","enH":"God the eternal.","bn":"আল্লাহ কোন কিছুর মুখাপেক্ষী নন, সবই তাঁর মুখাপেক্ষী,","tl":"Allahu assamad","j":30,"p":604,"h":60,"r":556,"s":0},{"n":3,"k":"112:3","ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","sim":"لم يلد ولم يولد","en":"He neither begets nor is born,","enH":"He begot no one nor was He begotten.","bn":"তিনি কাউকে জন্ম দেন না, আর তাঁকেও জন্ম দেয়া হয়নি।","tl":"Lam yalid walam yoolad","j":30,"p":604,"h":60,"r":556,"s":0},{"n":4,"k":"112:4","ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","sim":"ولم يكن له كفوا احد","en":"Nor is there to Him any equivalent.\"","enH":"No one is comparable to Him.’","bn":"তাঁর সমকক্ষ কেউ নয়।","tl":"Walam yakun lahu kufuwan ahad","j":30,"p":604,"h":60,"r":556,"s":0}]